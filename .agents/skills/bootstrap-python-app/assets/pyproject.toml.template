[build-system]
requires = ["hatchling>=1.29.0"]
build-backend = "hatchling.build"

[project]
name = "<app_name>"
version = "0.1.0"
description = "A Python application using hexagonal vertical-slice architecture."
readme = "README.md"
requires-python = ">=<python_version>"
dependencies = []

[project.urls]
Documentation = "<repository_url>#readme"
Repository = "<repository_url>"

[project.scripts]
"<app_name>" = "<app_name>.adapters.inbound.cli.__main__:main"

[dependency-groups]
dev = [
    "import-linter>=2.13",
    "pre-commit>=4.6.2",
    "pytest>=9.0.3",
    "pytest-cov>=7.1.0",
    "pytest-xdist>=3.8.0",
    "python-semantic-release>=10.5.2",
    "ruff>=0.16.3",
    "ty>=0.0.73",
]

[tool.semantic_release]
version_toml = ["pyproject.toml:project.version"]
assets = ["uv.lock"]
tag_format = "v{version}"
commit_message = "chore(release): v{version}"
build_command = "uv lock && uv build"
dist_path = "dist/"
upload_to_pypi = false
upload_to_release = false

[tool.hatch.build.targets.wheel]
packages = ["src/<app_name>"]

[tool.ruff]
line-length = 120
target-version = "py<python_version_nodot>" # e.g. py313 (version without the dot)
src = ["src", "tests"]
extend-exclude = [".agents"]

[tool.ruff.lint]
select = ["ALL"]
ignore = [
    "COM812",  # trailing comma — conflicts with ruff formatter
    "ISC001",  # implicit string concat — conflicts with ruff formatter
    "D203",    # one-blank-line-before-class — incompatible with D211
    "D213",    # multi-line-summary-second-line — incompatible with D212
    "D104",    # package __init__ modules are intentionally lightweight
    "D105",    # magic methods are documented through their owning types
    "D107",    # constructor contracts are documented on classes
    "CPY001",  # copyright headers are not used by default
    "TD",      # TODO comment format
    "FIX",     # fixme comments
]

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = [
    "ANN001", # pytest fixture parameters are intentionally inferred by name
    "ANN202", # private test helpers are typed when it improves clarity
    "D1",     # test names document behavior more clearly than docstrings
    "S101",   # pytest-native assertions are expected in tests
]

[tool.ty.src]
exclude = [".agents/**"]

[tool.importlinter]
root_package = "<app_name>"

[[tool.importlinter.contracts]]
id = "features-do-not-import-product-cli-or-bootstrap"
name = "Feature slices must not import product CLI or bootstrap"
type = "forbidden"
source_modules = ["<app_name>.features"]
forbidden_modules = [
    "<app_name>.adapters.inbound.cli",
    "<app_name>.bootstrap",
]

[[tool.importlinter.contracts]]
id = "feature-slices-follow-hexagonal-layers"
name = "Feature slices follow adapters -> application -> domain dependency direction"
type = "layers"
containers = ["<app_name>.features.*"]
layers = [
    "(adapters)",
    "application",
    "(domain)",
]

[[tool.importlinter.contracts]]
id = "feature-slice-dependencies-are-acyclic"
name = "Feature slice dependencies must remain acyclic"
type = "acyclic_siblings"
ancestors = ["<app_name>.features"]
depth = 0

[[tool.importlinter.contracts]]
id = "shared-kernel-stays-pure"
name = "Shared kernel must not import feature, adapter, or bootstrap code"
type = "forbidden"
source_modules = ["<app_name>.shared_kernel"]
forbidden_modules = [
    "<app_name>.adapters",
    "<app_name>.bootstrap",
    "<app_name>.features",
]

[[tool.importlinter.contracts]]
id = "generic-cli-shell-stays-feature-agnostic"
name = "Generic product CLI shell modules must not import features or bootstrap"
type = "forbidden"
allow_indirect_imports = true
source_modules = [
    "<app_name>.adapters.inbound.cli.__main__",
    "<app_name>.adapters.inbound.cli.options",
    "<app_name>.adapters.inbound.cli.parser",
    "<app_name>.adapters.inbound.cli.runner",
]
forbidden_modules = [
    "<app_name>.features",
    "<app_name>.bootstrap",
]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = [
    "-n=auto",
    "--cov=src",
    "--cov-report=term-missing",
]

[tool.coverage.run]
branch = true
source = ["src"]

[tool.coverage.report]
fail_under = <coverage_fail_under>
exclude_also = [
    "if TYPE_CHECKING:",
    "if __name__ == .__main__.",
]
